# Параметры тройного backhaul RuVDS → Hetzner.
#
# Скопировать в deploy/backhaul/params.env и заполнить. params.env в .gitignore:
# секреты в репозиторий не попадают.
#
#   cp deploy/backhaul/params.env.example deploy/backhaul/params.env
#   $EDITOR deploy/backhaul/params.env
#
# Все скрипты в deploy/ и scripts/backhaul/ читают именно этот файл.

# ─────────────────────────────── хосты ───────────────────────────────
HETZNER_IP=49.13.201.110
HETZNER_SSH_USER=root
HETZNER_SSH_KEY="${HOME}/.ssh/cloud-hetzner-v2"
HETZNER_SSH_PORT=22

# Рабочий адрес. У машины три адреса на eth0; на 194.87.80.237 входящий TCP
# заблокирован вне хоста (замер 23.08.2026: :22 и :443 в таймаут, при этом
# UDP на тот же адрес доходит). Административный доступ — только сюда.
RUVDS_IP=87.247.157.120
RUVDS_SSH_USER=root
RUVDS_SSH_KEY="${HOME}/.ssh/russian-vps"
# Административный SSH RuVDS. Его мы НЕ трогаем ни при каких обстоятельствах.
RUVDS_SSH_PORT=22

# Израильский резидентный узел. За NAT/CGNAT: входящих соединений не принимает,
# поэтому подключается к RuVDS сам. Адрес нужен только для локальной установки.
IL_SSH_TARGET=""          # напр. "pi@192.168.1.50" — только для запуска install.sh
IL_WG_ADDRESS=10.9.0.2

# ────────────────────────── WireGuard IL ↔ Hetzner ──────────────────────────
# Отдельный интерфейс wg1: wg0 занят старым туннелем RuVDS↔Hetzner и
# перегенерируется кодом vpnbot — не хотим, чтобы нас затирали.
WG_IF=wg1
WG_PORT=51821
WG_SUBNET=10.9.0.0/24
# Адрес Hetzner внутри wg1. Он же — единая точка входа backend'а для ВСЕХ трёх
# backhaul'ов: для secondary/emergency выход физически на Hetzner, и 10.9.0.1
# там локальный адрес; для primary он доезжает по wg1 из Израиля.
BACKEND_HOST=10.9.0.1

# ────────────────────────── primary: frp (IL residential) ──────────────────────────
# Пока израильского узла физически нет — держим primary выключенным. Выключенный
# tier не попадает ни в selector'ы sing-box, ни в опрос монитора: иначе монитор
# бесконечно ронял бы заведомо отсутствующий маршрут.
# Когда узел появится: PRIMARY_ENABLED=true → ./promote.sh --regenerate → проверить.
PRIMARY_ENABLED=false

# frps слушает на RuVDS, frpc живёт на израильском узле и подключается наружу.
FRP_VERSION=0.70.1
FRP_BIND_PORT=7443
# Токен общий для frps/frpc. Сгенерировать: openssl rand -hex 32
FRP_TOKEN=""
# Порты локальных SOCKS5-адаптеров, которые frps публикует на 127.0.0.1 RuVDS.
FRP_SOCKS_VLESS_PORT=11080
FRP_SOCKS_MTPROTO_PORT=11090

# ────────────────────────── secondary: Yandex Cloud → WSS ──────────────────────────
# Требует созданной ВМ в Yandex Cloud и A-записи. Пока их нет — false, и плечо
# не попадает ни в selector'ы, ни в опрос.
#
# Порядок ввода в строй, от наименее зависимого к наиболее:
#   emergency — не требует НИЧЕГО, кроме доступа по SSH к RuVDS;
#   secondary — требует ВМ в Yandex Cloud + DNS;
#   primary   — требует израильского резидентного узла.
# Поэтому первую работающую цепочку RuVDS→Hetzner показывает emergency.
SECONDARY_ENABLED=false

# Наш домен, A-запись → публичный IP виртуалки в Yandex Cloud (ru-central1).
YC_DOMAIN="cdn-ru.myvpn-api.online"
YC_VM_IP=""
# Домен, на котором уже живёт Caddy Hetzner (origin для YC).
HETZNER_ORIGIN="myvpn-api.online:8443"
# Путь WebSocket. Меняется вместе с Caddyfile Hetzner и конфигом YC.
BHWS_PATH="/bhws"
# UUID туннеля RuVDS ↔ Hetzner. Это НЕ пользовательский UUID: отдельный,
# только для транспорта. Сгенерировать: uuidgen
BHWS_UUID=""
# sing-box vless+ws inbound на Hetzner (только loopback, за Caddy).
BHWS_BACKEND_PORT=21080
SECONDARY_SOCKS_VLESS_PORT=11081
SECONDARY_SOCKS_MTPROTO_PORT=11091

# ────────────────────────── emergency: SSH-туннель ──────────────────────────
# ВНИМАНИЕ, направление инвертировано относительно изначального замысла.
#
# Изначально предполагалось «Hetzner инициирует reverse SSH к RuVDS». Замер
# 02.08.2026 показал, что это невозможно: RuVDS не принимает входящий TCP ни
# с Hetzner, ни из Израиля (развёртка 1–1024 — ноль открытых портов, connect
# уходит в таймаут без RST), при этом сам RuVDS исходящие соединения к Hetzner
# держит и обслуживает клиентов. Плечо, которое не может установиться,
# бесполезно, поэтому инициатор — RuVDS.
#
# Итог функционально тот же: SOCKS5 на 127.0.0.1 RuVDS, выход на Hetzner.
# Только вместо `ssh -R` с Hetzner используется `ssh -D` с RuVDS.
SSH_USER=backhaul
# Порт sshd Hetzner, куда ходит RuVDS. Если исходящий :22 у RuVDS
# отфильтрован — поднять на Hetzner дополнительный слушатель и указать его.
SSH_PORT=22
EMERGENCY_SOCKS_VLESS_PORT=11082
EMERGENCY_SOCKS_MTPROTO_PORT=11092
# Ключ живёт на RuVDS (он теперь клиент), публичная часть — на Hetzner.
SSH_KEY_PATH=/etc/backhaul/bh_ed25519

# ────────────────────────── relay sing-box на RuVDS ──────────────────────────
SINGBOX_RELAY_DIR=/etc/sing-box-relay
SINGBOX_RELAY_BIN=/usr/local/bin/sing-box
# Локальный официальный API sing-box. Только 127.0.0.1.
CLASH_API_LISTEN=127.0.0.1:19090
# Секрет API. Сгенерировать: openssl rand -hex 24
CLASH_API_SECRET=""

# Публичные порты RuVDS, которые relay обслуживает.
#
# НЕТ 443: его держит nginx (ssl_preread по SNI). sing-box не забиндит занятый
# порт и не поднимется ЦЕЛИКОМ — один лишний порт в списке кладёт весь relay.
#
# НЕТ 2059/2060/8446 (RU, RU-TCP, RU-STLS): они выходят в интернет с русского
# адреса через локальный sing-box, а relay увёл бы их в Hetzner.
#
# НЕТ 8445 (DE): намеренно оставлен на DNAT весь период миграции как
# нетронутый запасной путь — по тому же принципу, по которому в аварию
# 02.08.2026 выжили профили, не зависевшие от общей схемы.
#
# НЕТ 4443/8444/8447: см. PROTECTED_DIRECT_PORTS.
RELAY_VLESS_PORTS="2053 2054 2055 2056 2057 2058"
RELAY_MTPROTO_PORTS="9443"

# Порты с русским выходом. render-config.sh откажется собирать конфиг, если
# любой из них попадёт в RELAY_*_PORTS.
RU_DIRECT_EXIT_PORTS="2059 2060 8446"

# Staged rollout: те же маршруты, но на смещённых портах. Позволяет прогнать
# полный end-to-end до того, как трогать боевой DNAT.
STAGING_PORT_OFFSET=30000

# ────────────────────────── health checker ──────────────────────────
PROBE_LISTEN=10.9.0.1:18080
PROBE_INTERVAL_SEC=20
PROBE_FAIL_THRESHOLD=3
PROBE_RECOVER_THRESHOLD=5
PROBE_HOLD_DOWN_SEC=180
PROBE_STABLE_BEFORE_RETURN_SEC=300
PROBE_DOWNLOAD_BYTES=131072
PROBE_UPLOAD_BYTES=131072
PROBE_TIMEOUT_SEC=15
PROBE_STALL_SEC=5
PROBE_MIN_BPS=24576

# ────────────────────────── неприкосновенное ──────────────────────────
# Профили, которые ходят напрямую клиент→Hetzner в обход RuVDS: DE-VK (4443),
# DE-Yandex (8444), DE-Sber (8447). На 02.08.2026 это единственные работающие.
# render-config.sh откажется собирать конфиг, если любой из этих портов попадёт
# в RELAY_*_PORTS; verify.sh проверяет, что они по-прежнему отвечают на Hetzner
# и не подхвачены relay на RuVDS.
PROTECTED_DIRECT_PORTS="4443 8444 8447"
